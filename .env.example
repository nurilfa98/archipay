# Database (PostgreSQL)
DATABASE_URL=

# Kunci enkripsi cookie session, minimal 32 karakter.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

RESEND_API_KEY=
EMAIL_FROM=

# WhatsApp via Fonnte (https://fonnte.com). Token ada di menu Device.
# Kosongkan saat development: pesan hanya ditampilkan di terminal.
FONNTE_TOKEN=

# Zona waktu perusahaan: Asia/Jakarta (WIB), Asia/Makassar (WITA), Asia/Jayapura (WIT)
APP_TIMEZONE=Asia/Jakarta

# Penyimpanan foto nota: Cloudflare R2 (bucket PRIVAT, jangan aktifkan akses publik).
# 1. Cloudflare Dashboard → R2 → Create bucket, misal "archipay-receipts".
# 2. R2 → Manage API tokens → Create API token, izin "Object Read & Write",
#    batasi ke bucket di atas. Salin Access Key ID & Secret Access Key.
# 3. Account ID ada di halaman R2 (kanan atas).
# CORS tidak perlu diatur: file diunggah lewat server aplikasi, bukan langsung dari browser.
# Kosongkan keempatnya saat development: file disimpan di folder .storage/ (tidak ikut git).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Kunci endpoint pengingat WhatsApp harian /api/cron/reminders (minimal 16 karakter).
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# - Vercel: jadwal ada di vercel.json; Vercel mengirim header Authorization otomatis.
# - Hosting lain: panggil setiap hari pukul 08.00 WIB, misal dengan crontab:
#   0 1 * * * curl -s -H "Authorization: Bearer <CRON_SECRET>" https://domain-anda/api/cron/reminders
# Uji manual saat dev:
#   curl -H "Authorization: Bearer <CRON_SECRET>" http://localhost:3000/api/cron/reminders
CRON_SECRET=

# https://realitech.co.id
NEXT_PUBLIC_APP_URL=http://localhost:3000
